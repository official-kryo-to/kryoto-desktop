{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kryoto Desktop",
  "version": "0.2.11",
  "identifier": "to.kryo.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kryoto Desktop",
        "width": 340,
        "height": 380,
        "minWidth": 340,
        "minHeight": 380,
        "resizable": false,
        "center": true,
        "theme": "Dark",
        "decorations": false,
        "transparent": false,
        "backgroundColor": "#0a0a0a",
        "shadow": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline' 'unsafe-eval'; font-src 'self' data:; img-src 'self' data: blob: https: kimg: http://kimg.localhost; frame-src https://kryo.to https://*.kryo.to; connect-src 'self' ipc: http://ipc.localhost https://kryo.to https://*.kryo.to"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis",
      "deb",
      "appimage"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "installerIcon": "icons/icon.ico"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "publisher": "Kryoto",
    "homepage": "https://kryo.to",
    "category": "Game",
    "copyright": "Kryoto",
    "shortDescription": "The kryo.to desktop client",
    "longDescription": "Kryoto Desktop: the kryo.to store, your game library, downloads that install themselves, and every way a game starts."
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/official-kryo-to/kryoto-desktop/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVCNzZGNEI2NkM4Nzk0M0MKUldROGxJZHN0dlIyNitpeEtnWmRzNnY4R0txVm1HNkxoUmtucVd3NXFPc0pOcTNRL0VLbEdYcjcK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
